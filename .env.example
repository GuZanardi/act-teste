# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS (MySQL)
# DB_PORT     = porta interna do container MySQL (sempre 3306)
# HOST_DB_PORT = porta exposta no host (use 3307 se 3306 já estiver em uso)
# ==============================================================================
DB_SERVER=mysql
DB_PORT=3306
HOST_DB_PORT=3307
DB_NAME=financial_db
DB_USER=act_user
DB_PASSWORD=act_password
MYSQL_ROOT_PASSWORD=root_password

# ==============================================================================
# CONFIGURAÇÕES DA API (.NET 9)
# API_PORT = porta exposta no host
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5001

# ==============================================================================
# CONFIGURAÇÕES DO FRONTEND (React)
# ==============================================================================
REACT_APP_API_URL=http://localhost:5001
FRONTEND_PORT=3000
